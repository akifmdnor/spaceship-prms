# --- Spaceship PRMS API (copy to .env) ---
# cp server/.env.example server/.env

# PostgreSQL — your own instance (local install, Render, etc.). Compose does not start Postgres.
# Render / many hosts require TLS, e.g. append: ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/spaceship_prms?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-in-production-use-long-random-string"

PORT=3001

NODE_ENV=development

# Tests only: Vitest sets PRMS_AUTH_TEST=1 in server/tests/setup.ts (do not set in .env for normal dev)
