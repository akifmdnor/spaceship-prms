# --- Spaceship PRMS API (copy to .env) ---
# cp server/.env.example server/.env

# PostgreSQL (local: npm run db:up → port 5433)
DATABASE_URL="postgresql://prms:prms@localhost:5433/spaceship_prms?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-in-production-use-long-random-string"

PORT=3001

NODE_ENV=development

# Docker API container example:
# DATABASE_URL="postgresql://prms:prms@postgres:5432/spaceship_prms?schema=public"
# JWT_SECRET="use-docker-secret-or-host-env"

# Tests only: Vitest sets PRMS_AUTH_TEST=1 in server/tests/setup.ts (do not set in .env for normal dev)
