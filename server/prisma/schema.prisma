generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id
  email        String @unique
  passwordHash String @map("password_hash")
  name         String
  tier         Int
  isAdmin      Boolean @default(false) @map("is_admin")
  role         String // passenger | crew_lead

  usageEvents ResourceUsageEvent[]

  @@map("users")
}

model Resource {
  id                String  @id
  name              String
  minRequiredTier   Int     @map("min_required_tier")
  usageCount        Int     @default(0) @map("usage_count")
  capacityPercent   Int     @default(0) @map("capacity_percent")
  facilityBonus     String? @map("facility_bonus")

  usageEvents ResourceUsageEvent[]

  @@map("resources")
}

model ResourceUsageEvent {
  id         String   @id @default(uuid()) @db.Uuid
  ts         DateTime @default(now())
  userId     String   @map("user_id")
  resourceId String   @map("resource_id")
  userTier   Int      @map("user_tier")
  outcome    String // success | denied

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId, ts(sort: Desc)])
  @@index([outcome, ts(sort: Desc)])
  @@map("resource_usage_events")
}

model AuditLog {
  id       String   @id @db.Uuid
  ts       DateTime @default(now())
  severity String
  message  String

  @@index([ts(sort: Desc)])
  @@map("audit_logs")
}
