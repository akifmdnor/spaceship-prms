{
  "name": "spaceship-prms",
  "version": "1.0.0",
  "private": true,
  "description": "Spaceship X26 — Passenger Resource Management System (monorepo)",
  "workspaces": [
    "web-client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "db:down": "docker compose -f server/docker-compose.yml down",
    "docker:up": "docker compose up -d --build",
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev -w web-client\" \"npm run dev -w server\"",
    "build": "npm run build -w server && npm run build -w web-client",
    "render:build:api": "npm run build -w server",
    "render:start:api": "npm run start -w server",
    "render:migrate:api": "npm run db:migrate -w server",
    "render:build:web": "npm run build -w web-client",
    "render:start:web": "npm run start -w web-client",
    "test": "npm run test -w server",
    "test:watch": "npm run test:watch -w server",
    "test:coverage": "npm run test:coverage -w server",
    "lint": "eslint server web-client --max-warnings 0",
    "lint:fix": "eslint server web-client --fix --max-warnings 0",
    "format": "prettier --write \"server/**/*.{ts,tsx}\" \"web-client/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"server/**/*.{ts,tsx}\" \"web-client/**/*.{ts,tsx}\"",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web-client"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=20"
  }
}
